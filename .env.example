# 服务配置
LISTEN_ADDR=:8080
GIN_MODE=debug
LOG_LEVEL=info

# 连接限制
MAX_CONNECTIONS=100
MAX_CONCURRENT_CALLS=10
CHECK_INTERVAL=5

# 火山引擎配置（实际使用时需要填写真实值）
BYTEDANCE_TTS_APP_ID=your_app_id_here
BYTEDANCE_TTS_BEARER_TOKEN=your_token_here
BYTEDANCE_TTS_CLUSTER=your_cluster_here
BYTEDANCE_TTS_VOICE_TYPE=your_voice_type_here

# OpenAI TTS API Key（可选）
OPENAI_TTS_API_KEY=your_api_key_here