# 服务配置
LISTEN_ADDR=:8080
GIN_MODE=debug
LOG_LEVEL=info

# 连接限制
MAX_CONNECTIONS=100
MAX_CONCURRENT_CALLS=10
CHECK_INTERVAL=5

# 火山引擎配置（示例值）
BYTEDANCE_TTS_APP_ID=test_app_12345
BYTEDANCE_TTS_BEARER_TOKEN=test_token_abcdef
BYTEDANCE_TTS_CLUSTER=test_cluster
BYTEDANCE_TTS_VOICE_TYPE=zh_speaker_1

# OpenAI TTS API Key（示例值）
OPENAI_TTS_API_KEY=test_openai_key